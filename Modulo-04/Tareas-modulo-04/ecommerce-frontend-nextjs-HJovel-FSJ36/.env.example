# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y ajusta los valores:
#   cp .env.example .env.local
# NUNCA subas .env.local a GitHub (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# URL base de la API REST de e-commerce (Laravel 12), incluyendo el prefijo /api
# y SIN barra final. Solo se lee en el servidor (no lleva NEXT_PUBLIC_).
BASE_URL=http://localhost:8000/api

# Método de pago de Stripe en modo TEST que se envía al endpoint de pago.
# pm_card_visa = tarjeta de prueba 4242 4242 4242 4242 (token de Stripe test).
STRIPE_PAYMENT_METHOD=pm_card_visa

# (Opcional) fuerza el atributo Secure de la cookie. Por defecto es true en
# producción y false en desarrollo. Pon "false" si pruebas `npm run start`
# por HTTP en un navegador que no acepte cookies Secure en localhost.
# COOKIE_SECURE=false
