# Copia este archivo como .env.local y completa los valores. NUNCA subas .env.local a GitHub.

# Cadena de conexión de Neon (Neon Console -> Connect -> "Pooled connection").
# Debe incluir ?sslmode=require. Es un SECRETO: no lleva prefijo NEXT_PUBLIC_.
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# URL pública de la app (sin barra final).
# Local: http://localhost:3000  |  Producción: https://tu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPCIONAL — correos reales (verificación de correo y recuperación de contraseña) con Resend.
# Sin esta clave: en desarrollo los enlaces se imprimen en la terminal de `npm run dev`
# y las cuentas nuevas quedan verificadas automáticamente.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="SecureAuth <onboarding@resend.dev>"
