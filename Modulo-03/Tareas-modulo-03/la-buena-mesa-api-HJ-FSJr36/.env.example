APP_NAME="La Buena Mesa API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/El_Salvador
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------
# Base de datos
# --------------------------------------------------------------------
# Opción A (recomendada para desarrollo local / esta actividad): SQLite
DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/al/proyecto/database/database.sqlite

# Opción B: MySQL (descomentar y ajustar si se prefiere MySQL/MariaDB)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=la_buena_mesa
# DB_USERNAME=root
# DB_PASSWORD=

# Opción C: PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=la_buena_mesa
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@labuenamesa.test"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------
# CORS - orígenes permitidos para consumir la API
# (app web, futura app móvil, sistema POS). Usar "*" solo en desarrollo.
# --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
