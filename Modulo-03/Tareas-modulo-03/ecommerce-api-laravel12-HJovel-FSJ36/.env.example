APP_NAME="Ecommerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/El_Salvador
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==========================
# BASE DE DATOS (MySQL)
# ==========================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_api
DB_USERNAME=ecommerce_user
DB_PASSWORD=ventu

# ==========================
# SESSION / CACHE / QUEUE
# ==========================
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ==========================
# JWT (tymon/jwt-auth)
# Generar con: php artisan jwt:secret
# ==========================
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# ==========================
# STRIPE
# Obtener claves en https://dashboard.stripe.com/test/apikeys
# ==========================


# ==========================
# L5-SWAGGER (Swagger/OpenAPI)
# ==========================
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000/api
L5_FORMAT_TO_USE_FOR_DOCS=json
