# Copia este archivo a .env.local y completa los valores:
#   Debian/Linux:  cp .env.example .env.local
#   Windows (PS):  Copy-Item .env.example .env.local
# .env.local NUNCA se sube a GitHub (esta en .gitignore).

# Cadena de conexion de Neon (Dashboard del proyecto -> Connect). Solo servidor: NO uses NEXT_PUBLIC_.
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxxxx-pooler.us-east-1.aws.neon.tech/fadelab?sslmode=require

# Slug del negocio que muestra la app (debe existir en la tabla negocios; el seed crea "fade-lab")
NEGOCIO_SLUG=fade-lab

# URL publica de la app. En local: http://localhost:3000 - En Vercel: https://tu-proyecto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave para GET /api/citas (agenda del dueno). Cambiala por una larga y aleatoria.
ADMIN_API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
