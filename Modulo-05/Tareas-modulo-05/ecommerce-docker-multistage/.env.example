# =============================================================================
# .env.example — copia a .env y cambia los valores:   cp .env.example .env
# O genera todo automático:                            ./scripts/gen-secrets.sh
# NUNCA subas .env a GitHub (ya está en .gitignore).
# NUNCA pongas llaves reales (Stripe, etc.) en este archivo ni en el README.
# =============================================================================

# --- Generales ---------------------------------------------------------------
TZ=America/El_Salvador

# --- Puertos publicados en el host --------------------------------------------
# Cambia si ya usas 3000 (next dev) u 8000 (php artisan serve) en tu equipo.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- MySQL 8.0 ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CAMBIAR_ROOT_PASSWORD
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=CAMBIAR_DB_PASSWORD
# Solo con docker-compose.dev.yml: puerto del host (127.0.0.1) hacia MySQL
DB_HOST_PORT=3307

# --- Backend Laravel ---------------------------------------------------------
# Versión de PHP de la imagen (>= 8.2). Sube a 8.3/8.4 si tu composer.lock lo exige.
PHP_VERSION=8.4
APP_NAME=EcommerceAPI
# Genera con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=CAMBIAR_APP_KEY
APP_URL=http://localhost:8000
# Genera con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_JWT_SECRET
# Stripe: usa llaves de PRUEBA (sk_test_...) solo en tu .env local
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# URL base que mostrará Swagger UI (l5-swagger) para "Try it out"
L5_SWAGGER_CONST_HOST=http://localhost:8000/api
# Ejecuta `php artisan migrate --force` al iniciar el contenedor
RUN_MIGRATIONS=true
# Regenera la documentación Swagger al iniciar (si el paquete existe)
RUN_SWAGGER_GENERATE=true

# --- Frontend Next.js --------------------------------------------------------
NODE_VERSION=20
# Dockerfile a usar: Dockerfile (next start) | Dockerfile.standalone (opcional)
FRONTEND_DOCKERFILE=Dockerfile
# URL de la API vista DESDE EL CONTENEDOR del frontend (red interna de Docker).
# Ajusta el NOMBRE de la variable al que lee tu código (p. ej. BASE_URL).
BASE_URL=http://backend/api
# URL de la API vista DESDE EL NAVEGADOR (solo si usas NEXT_PUBLIC_* en cliente)
NEXT_PUBLIC_BASE_URL=http://localhost:8000/api

# Cookie de sesión: false mientras no haya HTTPS delante (true si pones un proxy TLS)
COOKIE_SECURE=false
STRIPE_PAYMENT_METHOD=pm_card_visa
