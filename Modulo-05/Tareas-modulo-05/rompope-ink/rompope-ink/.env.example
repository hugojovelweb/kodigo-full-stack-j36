# .env.example — variables de Rompope Ink (sin secretos reales).
# Desarrollo local:  cp .env.example .env.local
# Producción: se cargan en AWS Amplify → Hosting → Environment variables (NUNCA en el repo).

# Nombre del estudio (se muestra en la web y en /api/health)
NEXT_PUBLIC_STUDIO_NAME=Rompope Ink

# URL pública del sitio. En producción: la URL de Amplify (https://main.xxxx.amplifyapp.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp del estudio, solo dígitos con código de país (503 = El Salvador). Valor de ejemplo.
NEXT_PUBLIC_WHATSAPP_NUMBER=50300000000
